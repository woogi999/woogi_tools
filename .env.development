# This file is committed to git and should not contain any secrets.
# 
# Vite recommends using .env.local or .env.[mode].local if you need to manage secrets
# SEE: https://vite.dev/guide/env-and-mode.html#env-files for more information.


# Default NODE_ENV with vite build --mode=test is production
NODE_ENV=development

# Roblox sign-in for the JJS Progress Bar Maker's "upload to Roblox" export.
# Register an OAuth 2.0 app at https://create.roblox.com/dashboard/credentials
# with the redirect URI <site origin>/roblox-callback.html (add
# http://localhost:5173/roblox-callback.html for local work too) and the
# scopes: openid profile asset:read asset:write legacy-asset:manage.
# The client ID of a public (PKCE) client isn't a secret. Leave it unset and
# the export still works, with image IDs pasted in by hand.
# VITE_ROBLOX_CLIENT_ID=
