{
  "name": "woogi-tools",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Only /api/* runs the Worker; every other request is a static file from the build.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TURN_KEY_ID": "2900fc412b4c30e1bdc49baf7079dc59"
  }
  // Secrets, set with `npx wrangler secret put <NAME>` (never committed):
  //   TURN_KEY_ID          the Cloudflare Realtime TURN key id
  //   TURN_KEY_API_TOKEN   that key's API token
}
