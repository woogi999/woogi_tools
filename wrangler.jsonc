{
  "name": "woogi-tools",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Only /api/* runs the Worker; every other request is a static file from the build.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TURN_KEY_ID": "2900fc412b4c30e1bdc49baf7079dc59"
  },
  // Disposable Emails: incoming mail waits here for an hour. Create the
  // namespace with `npx wrangler kv namespace create TEMP_MAIL` and paste
  // its id below; then in the dashboard enable Email Routing for
  // temp.woogi.xyz with a catch-all rule that sends to this Worker.
  "kv_namespaces": [
    {
      "binding": "TEMP_MAIL",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  // Worker logs, including one log per invocation, visible in the Cloudflare dashboard.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
  // Secrets, set with `npx wrangler secret put <NAME>` (never committed):
  //   TURN_KEY_ID           the Cloudflare Realtime TURN key id
  //   TURN_KEY_API_TOKEN    that key's API token
  //
  // Optional, for the Grammar Checker and Paraphraser (they fall back to the
  // free public LanguageTool if none of these are set):
  //   LANGUAGETOOL_URL       a self-hosted LanguageTool's check endpoint
  //   LANGUAGETOOL_USERNAME  a LanguageTool Premium account, if you have one
  //   LANGUAGETOOL_API_KEY   that account's key
}
