{
  "name": "woogi-tools",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // /api/* and page loads run the Worker (page loads so it can add each page's
  // link-preview tags); the build's asset folders below are served straight
  // from the build without it.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/hero_banners/*",
      "!/legal/*",
      "!/models/*",
      "!/search_assets/*",
      "!/sounds/*",
    ],
  },
  "vars": {
    "TURN_KEY_ID": "2900fc412b4c30e1bdc49baf7079dc59",
  },
  // File Share's WebSocket relay (worker/relay-room.js): one room per share
  // code, used only when WebRTC can't connect the two browsers directly.
  "durable_objects": {
    "bindings": [{ "name": "RELAY_ROOM", "class_name": "RelayRoom" }],
  },
  // SQLite-backed, so this works on the free plan too.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  // Worker logs, including one log per invocation, visible in the Cloudflare dashboard.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // Secrets, set with `npx wrangler secret put <NAME>` (never committed):
  //   TURN_KEY_ID           the Cloudflare Realtime TURN key id
  //   TURN_KEY_API_TOKEN    that key's API token
  //
  // Optional, for the Grammar Checker and Paraphraser (they fall back to the
  // free public LanguageTool if none of these are set):
  //   LANGUAGETOOL_URL       a self-hosted LanguageTool's check endpoint
  //   LANGUAGETOOL_USERNAME  a LanguageTool Premium account, if you have one
  //   LANGUAGETOOL_API_KEY   that account's key
  //
  // For the Video Downloader and the Bunkr Downloader: the site's download
  // backend (backend/, hosted on Render from render.yaml). Without these the
  // Video Downloader still saves from X, TikTok, Facebook, Reddit and
  // Streamable on its own; with them, YouTube and the rest go through yt-dlp
  // on the backend, and the Bunkr Downloader works at all.
  //   DOWNLOAD_API_URL       the backend's address, e.g. https://woogi-downloads.onrender.com
  //   DOWNLOAD_API_KEY       the backend's API_KEY (Render makes one; copy it from its Environment tab)
}
