    "@huggingface/transformers": "^4.2.0",
    "@imagemagick/magick-wasm": "^0.0.43",
    "@imgly/background-removal": "^1.7.0",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "7z-wasm": "^1.2.0",
    "brotli-wasm": "^3.0.1",
    "chess.js": "^1.4.0",
    "crayon-css": "^0.10.2",
    "exifr": "^7.1.3",
