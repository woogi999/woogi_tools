    "pdfjs-dist": "^6.3.289",
    "peerjs": "^1.5.5",
    "qr-code-styling": "^1.9.2",
    "sketchyicons": "^0.5.0",
    "smol-toml": "^1.8.0",
    "three": "^0.186.0",
    "woff2-encoder": "^2.0.0",
    "yaml": "^2.9.1"
  }
